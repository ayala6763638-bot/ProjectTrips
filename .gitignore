dist/
build/
.out/
public/build/
.vite/
.cache/
.parcel-cache/
.cache-loader/

.env
.env.local
.env.*.local
.env.test
.env.production

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon

logs/
*.log

*.sqlite
*.sqlite3
*.db

*.tsbuildinfo

.cache/
.sass-cache/

.next/
.out/
.parcel-cache/

*.iml
*.iws
.idea/

.env.local
.env.*.local


