# Standard .gitignore for Node.js + Vite (frontend) projects

# Node modules
node_modules/
# Yarn/NPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage and test output
coverage/
.nyc_output/
coverage-final.json

# Build output
dist/
build/
.out/
public/build/
.vite/
.cache/
.parcel-cache/
.cache-loader/

# Environment files (keep example files like .env.example)
.env
.env.local
.env.*.local
.env.test
.env.production

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon

# Logs
logs/
*.log

# Database files
*.sqlite
*.sqlite3
*.db

# TypeScript cache
*.tsbuildinfo

# Misc caches
.cache/
.sass-cache/

# Parcel / Next / other frameworks
.next/
.out/
.parcel-cache/

# JetBrains
*.iml
*.iws
.idea/

# Sensitive or local files
.env.local
.env.*.local

# Optional: lock files are usually committed (package-lock.json, yarn.lock, pnpm-lock.yaml)
# Do not ignore lockfiles unless you intentionally want to.

# End of file
